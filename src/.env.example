# Salin berkas ini menjadi .env.local; jangan commit konfigurasi yang berisi rahasia.
# db:setup membuat cluster lokal khusus repo jika DATABASE_URL kosong.
# Untuk database yang sudah ada, gunakan URL database lokal khusus aplikasi.
DATABASE_URL=
# Sesuaikan dengan folder bin instalasi PostgreSQL.
POSTGRES_BIN=C:/Program Files/PostgreSQL/18/bin
# Opsional: origin HTTPS tunnel tanpa path, misalnya https://contoh.ngrok-free.app.
# Kosongkan untuk akses localhost.
APP_PUBLIC_ORIGIN=
# Email di bawah ditetapkan oleh setup, bukan pengaturan email yang dapat diganti.
# Password bootstrap dibuat otomatis jika kosong; tidak dicetak ke log.
# Perubahan nilai ini tidak mengganti password akun yang sudah dibuat.
LOCAL_ADMIN_EMAIL=admin@funding.local
LOCAL_ADMIN_PASSWORD=
LOCAL_MEMBER_EMAIL=anggota@funding.local
LOCAL_MEMBER_PASSWORD=
